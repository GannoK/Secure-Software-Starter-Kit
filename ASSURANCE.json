    },
    {
      "name": "OpenSSF Scorecard",
      "status": "automated"
    },
    {
      "name": "NIST SSDF SP 800-218",
      "status": "mapped"
    },
    {
      "name": "SLSA 1.2",
      "status": "profiled"
    },
    {
      "name": "CISA Secure by Design",
      "status": "mapped"
    }
  ],
  "manual_controls": [
    "threat_model_quality",
    "cryptographic_design_review",
    "security_test_coverage",
